diff --git a/kernel/Kbuild b/kernel/Kbuild
index b7655cb3..75578f89 100644
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -91,15 +91,19 @@ KSU_VERSION_FULL := $(subst %REPO_NAME%,$(REPO_NAME),$(KSU_VERSION_FULL))
 KSU_VERSION_FULL := $(subst %BRANCH_NAME%,$(KSU_BRANCH_NAME),$(KSU_VERSION_FULL))
 KSU_VERSION_FULL := $(subst %KSU_VERSION%,$(KSU_VERSION),$(KSU_VERSION_FULL))
 
+# Preserve the configured version prefix and replace only an existing channel suffix.
+ifneq ($(findstring @,$(KSU_VERSION_FULL)),)
+KSU_CHANNEL := $(lastword $(subst @, ,$(KSU_VERSION_FULL)))
+KSU_VERSION_FULL := $(patsubst %@$(KSU_CHANNEL),%@BakaSUPro,$(KSU_VERSION_FULL))
+endif
+
 $(info -- $(REPO_NAME) version code: $(KSU_VERSION))
 $(info -- $(REPO_NAME) version name: $(KSU_VERSION_FULL))
 
 ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
 ccflags-y += -DKSU_VERSION_FULL=\"$(KSU_VERSION_FULL)\"
 
-ifdef CONFIG_KSU_MULTI_MANAGER_SUPPORT
-$(info -- Supported Managers: KernelSU Official, KOWSU, BakaSU )
-endif
+$(info -- Trusted Manager: BakaSU Pro private certificate)
 
 KERNEL_VERSION := $(VERSION).$(PATCHLEVEL)
 KERNEL_TYPE := Non-GKI
